# --- Frontend (React Native CLI / Expo) ---
Frontend/node_modules/
Frontend/dist/
Frontend/web-build/
Frontend/expo-env.d.ts

# Expo specific
Frontend/.expo/
Frontend/.expo-packager-cache/
Frontend/.expo-developer-tools/

# Metro bundler cache
Frontend/.metro/
Frontend/.rncache/
Frontend/.metro-health-check*

# Android
Frontend/android/.gradle/
Frontend/android/app/build/
Frontend/android/build/
Frontend/*.iml
Frontend/*.jks
Frontend/*.keystore
Frontend/local.properties

# iOS
Frontend/ios/build/
Frontend/ios/DerivedData/
Frontend/ios/Pods/
Frontend/*.pbxuser
Frontend/*.mode1v3
Frontend/*.mode2v3
Frontend/*.perspectivev3
Frontend/xcuserdata/

# Keys & certificates
Frontend/*.orig.*
Frontend/*.p8
Frontend/*.p12
Frontend/*.pem
Frontend/*.key
Frontend/*.mobileprovision

# Logs
Frontend/npm-debug.log*
Frontend/yarn-debug.log*
Frontend/yarn-error.log*

# Misc frontend
Frontend/.DS_Store
Frontend/*.tsbuildinfo
Frontend/app-example

# --- Backend (Django / Python) ---
Backend/venv/
Backend/.venv/
Backend/env/
.env

# ✅ CORRECTION CRITIQUE : Ignore absolument TOUS les caches compilés Python dans l'arborescence
**/__pycache__/
*.py[cod]
*$py.class

# Database
Backend/*.sqlite3
Backend/db.sqlite3

# ✅ CORRECTION CRITIQUE : N'ignore PAS les fichiers de migration (.py), seulement leur cache
**/migrations/__pycache__/

# Logs & Assets
Backend/*.log
Backend/media/
Backend/staticfiles/
Backend/*.pot
Backend/*.mo

# --- Tests / Coverage ---
coverage/
.coverage
htmlcov/
junit.xml
.pytest_cache/
.tox/
.mypy_cache/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Divers ---
*.swp
*.swo
*.bak
