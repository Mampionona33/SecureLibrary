{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "baseUrl":".",
    "paths":{
	"*":["src/*"],
	"test":["tests/*"],
	"@components/*":["src/components/*"],
	"@screens/*":["src/screens/*"],
	"@hooks/*":["src/hooks/*"],
	"@assets/*":["src/assets/*"],
	"@navigation/*":["src/navigation/*"],
	"@utils/*":["src/utils/*"],
	"@constants/*":["src/constants/*"],
	"@services/*":["src/services/*",
	"@store/*":["src/store/*"],
	"@context/*":["src/context/*"],
	"@api/*":["src/api/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
